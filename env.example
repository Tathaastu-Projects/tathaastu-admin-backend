# MongoDB
MONGODB_URI=mongodb://localhost:27017/tathasstu-admin

# Server
PORT=3024
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development

# Optional — store customer JWT (falls back to JWT_SECRET)
# STORE_JWT_SECRET=
# STORE_JWT_EXPIRES=7d

# Optional — shown on storefront support surfaces
# STORE_SUPPORT_EMAIL=support@example.com
# STORE_SUPPORT_PHONE=

# Optional — Razorpay (omit for mock/dev payment mode)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Optional — Microsoft Graph outbound email
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=
# ADMIN_NOTIFICATION_EMAILS=
