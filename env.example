# Server (required)
PORT=3024
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development

# Optional — store customer JWT (falls back to JWT_SECRET)
# STORE_JWT_SECRET=
# STORE_JWT_EXPIRES=7d

# Optional — shown on storefront support surfaces
# STORE_SUPPORT_EMAIL=support@example.com
# STORE_SUPPORT_PHONE=

# Optional — Razorpay (legacy stub; prefer Easebuzz for online checkout)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Easebuzz Hosted Checkout (store online payments)
# Leave KEY/SALT empty for demo mode (POST /api/payment/easebuzz/confirm-demo)
# EASEBUZZ_KEY=
# EASEBUZZ_SALT=
# EASEBUZZ_ENV=test
# EASEBUZZ_IFRAME=0
# PAYMENT_GATEWAY=easebuzz
#
# Storefront origin used to build surl/furl after payment
# FRONTEND_BASE_URL=http://localhost:3000
# Optional overrides (default: {FRONTEND_BASE_URL}/payment?status=...&txnid=...&orderId=...)
# EASEBUZZ_SUCCESS_URL=
# EASEBUZZ_FAILURE_URL=

# Optional — Microsoft Graph outbound email
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=
# ADMIN_NOTIFICATION_EMAILS=

# NOTE: MongoDB is no longer used.
# All data lives under ./storage/data/*.json
# All uploaded media lives under ./uploads/ and ./storage/images/
