# Server (required)
PORT=3024
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development

# Optional — store customer JWT (falls back to JWT_SECRET)
# STORE_JWT_SECRET=
# STORE_JWT_EXPIRES=7d

# Optional — shown on storefront support surfaces
# STORE_SUPPORT_EMAIL=support@example.com
# STORE_SUPPORT_PHONE=

# Optional — Razorpay (legacy stub; prefer Easebuzz)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Easebuzz Hosted Checkout (store online payments)
# Prefer EASEBUZZ_MERCHANT_KEY; EASEBUZZ_KEY also accepted.
# Leave KEY/SALT empty for demo mode (confirm-demo).
# EASEBUZZ_MERCHANT_KEY=
# EASEBUZZ_KEY=
# EASEBUZZ_SALT=
# EASEBUZZ_ENVIRONMENT=test
# EASEBUZZ_ENV=test
# EASEBUZZ_IFRAME=0
# EASEBUZZ_PAYMENT_HOLD_MS=900000
# PAYMENT_GATEWAY=easebuzz
# PAYMENT_TOKEN_SECRET=
#
# Public URLs used for surl/furl redirects + storefront redirects
# BACKEND_PUBLIC_URL=http://localhost:3024
# STOREFRONT_URL=http://localhost:3000
# FRONTEND_BASE_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# Optional — Microsoft Graph outbound email
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=
# ADMIN_NOTIFICATION_EMAILS=

# NOTE: MongoDB is no longer used.
# All data lives under ./storage/data/*.json
# All uploaded media lives under ./uploads/ and ./storage/images/
